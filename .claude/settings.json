{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/post_edit_verify.sh\"",
            "timeout": 60,
            "statusMessage": "Running gate for edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/stop_checks.sh\"",
            "timeout": 120,
            "statusMessage": "Running doc-sync"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/spec_capture_reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
